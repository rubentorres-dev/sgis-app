<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="sgis.vista.ConfigUsuariosVista"
      stylesheets="@../css/estilos.css"
      spacing="12">
    <padding>
        <Insets top="16" right="18" bottom="16" left="18" />
    </padding>

    <Label text="Cuentas con las que se entra al sistema. Para cambiar una contraseña: pulsa 🔑 Clave, copia la clave, y en ✏ Editar pégala en «Clave temporal» y escribe la contraseña nueva. El ojo muestra la contraseña actual (solo el Administrador); las creadas antes de esta función no se pueden ver. El usuario con 🔒 está protegido: nadie puede editarlo, desactivarlo, eliminarlo ni ver o cambiar su contraseña."
           style="-fx-text-fill: #78809A;" wrapText="true" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="campoBusqueda" promptText="Buscar por nombre, usuario o rol..." prefWidth="340" />
        <Label fx:id="lblResultado" text="" />
        <Region HBox.hgrow="ALWAYS" />
        <Button styleClass="boton-primario" text="+ Nuevo usuario" onAction="#abrirFormularioNuevo" />
    </HBox>

    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="130" />
            <TableColumn fx:id="colLogin" text="Usuario" prefWidth="100" />
            <TableColumn fx:id="colRol" text="Rol" prefWidth="175" />
            <TableColumn fx:id="colContrasena" text="Contraseña" prefWidth="140" />
            <TableColumn fx:id="colCedula" text="Cédula" prefWidth="160" />
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110" />
            <TableColumn fx:id="colCodigo" text="Código de recuperación" prefWidth="170" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="80" />
            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="400" />
        </columns>
    </TableView>

    <Label fx:id="lblMensaje" text="" wrapText="true" />
</VBox>
